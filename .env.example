# Duplicate this file as ".env.local" to configure local development settings.
# DO NOT commit ".env.local" or any files containing actual secrets to Git.
# On Vercel: add these as Environment Variables in the project dashboard.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Event Configuration (if applicable)
NEXT_PUBLIC_EVENT_NAME="Hacktivate 2.0"
NEXT_PUBLIC_EVENT_DATE="2026-09-11T10:00:00+05:30"

# Sponsorship contact form (Web3Forms — https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# External API Integrations (Optional templates)
# NEXT_PUBLIC_ANALYTICS_ID=
# DATABASE_URL=
# AUTH_SECRET=
